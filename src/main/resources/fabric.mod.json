{
  "schemaVersion": 1,
  "id": "biblioteca",
  "version": "${version}",
  "name": "Biblioteca",
  "description": "Adds per-dimension Y-axis looping: y=-64 wraps to y=319, entities and block access fold seamlessly, and the renderer shows the wrapped terrain across the seam.",
  "authors": [
    "Me!"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/biblioteca/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "babel.biblioteca.Biblioteca"
    ],
    "client": [
      "babel.biblioteca.client.BibliotecaClient"
    ]
  },
  "mixins": [
    "biblioteca.mixins.json",
    {
      "config": "biblioteca.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
