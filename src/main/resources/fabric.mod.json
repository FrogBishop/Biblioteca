{
  "schemaVersion": 1,
  "id": "biblioteca",
  "version": "${version}",
  "name": "Biblioteca",
  "description": "Adds per-dimension period to Y-axis",
  "authors": [
    "FrogBishop"
  ],
  "contact": {
    "homepage": "https://github.com/FrogBishop/Biblioteca",
    "sources": "https://github.com/FrogBishop/Biblioteca"
  },
  "license": "GPLv3",
  "icon": "assets/biblioteca/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "babel.biblioteca.fabric.FabricBiblioteca"
    ],
    "client": [
      "babel.biblioteca.client.fabric.FabricBibliotecaClient"
    ]
  },
  "mixins": [
    "biblioteca.mixins.json",
    {
      "config": "biblioteca.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "${fabric_api_id}": "*"
  }
}
